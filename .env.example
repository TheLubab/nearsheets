# All VITE_ values are public browser configuration. Never put secrets here.
VITE_NEAR_NETWORK=mainnet
# Optional HTTP(S) RPC override. Defaults to the selected network's public RPC.
VITE_NEAR_RPC_URL=https://free.rpc.fastnear.com
# Optional hosted NEAR Connect manifest, e.g. one including an embedded wallet.
# This replaces the connector manifest; include the normal wallets as needed.
VITE_WALLET_MANIFEST_URL=
# Optional actual Trezu integration endpoint (no enrichment adapter selected).
VITE_TREZU_API_URL=
# 1Click-compatible public API. Defaults to https://1click.chaindefuser.com; set to none to disable.
VITE_INTENTS_API_URL=
# Optional NearSheets-owned/authorized cookie-session backend; never Trezu cookies.
VITE_AUTH_API_URL=
# Vercel Web Analytics. Defaults to auto; use production/development to force a script, none to disable.
VITE_VERCEL_ANALYTICS_MODE=
