# Public browser configuration only. Never put secrets in VITE_ variables.
# The app runs without an env file (wallet defaults to testnet).
# Copy to .env.local for a mainnet wallet default, or set this in your host:
VITE_NEAR_NETWORK=mainnet

# Defaults already work; leave these unset unless you need an override.
# Intents uses https://1click.chaindefuser.com. Use none to disable it.
# VITE_INTENTS_API_URL=none
# Analytics uses auto. Use none to disable it.
# VITE_VERCEL_ANALYTICS_MODE=none

# Advanced overrides — leave unset for the standard wallet and public RPC fallback.
# A custom RPC applies only to VITE_NEAR_NETWORK and disables public fallback there.
# VITE_NEAR_RPC_URL=https://your-rpc.example
# A custom manifest replaces the connector's default wallet list.
# VITE_WALLET_MANIFEST_URL=https://your-wallets.example/manifest.json
# Only for an actual authorized NearSheets cookie-session service.
# VITE_AUTH_API_URL=https://your-auth.example
